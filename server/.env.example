MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
PORT=5000
CLIENT_ORIGINS=http://localhost:3000,https://guessmydoodle.vercel.app
GUEST_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional, required only for Firebase authenticated accounts:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
